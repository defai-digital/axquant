{
  "$defs": {
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "ReleaseAuditCheck": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "gate_id": {
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3",
            "M4",
            "M5",
            "M6",
            "M7",
            "M8"
          ],
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "gate_id",
        "name",
        "passed"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "candidate_model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ReleaseAuditCheck"
      },
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "release_ready": {
      "type": "boolean"
    },
    "request_sha256": {
      "type": "string"
    },
    "schema_version": {
      "const": "axquant.release-audit.v4",
      "default": "axquant.release-audit.v4",
      "type": "string"
    },
    "source_model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "toolkit_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "wheel_sha256": {
      "type": "string"
    }
  },
  "required": [
    "request_sha256",
    "candidate_model",
    "source_model",
    "wheel_sha256",
    "checks",
    "release_ready"
  ],
  "type": "object"
}
