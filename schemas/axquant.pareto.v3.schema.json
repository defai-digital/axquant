{
  "$defs": {
    "CompleteCandidateHardware": {
      "additionalProperties": false,
      "properties": {
        "ax_engine_version": {
          "minLength": 1,
          "type": "string"
        },
        "chip": {
          "minLength": 1,
          "type": "string"
        },
        "device_name": {
          "minLength": 1,
          "type": "string"
        },
        "kernel_fallbacks": {
          "minimum": 0,
          "type": "integer"
        },
        "mlx_lm_version": {
          "minLength": 1,
          "type": "string"
        },
        "mlx_version": {
          "minLength": 1,
          "type": "string"
        },
        "os_version": {
          "minLength": 1,
          "type": "string"
        },
        "power_mode": {
          "minLength": 1,
          "type": "string"
        },
        "unified_memory_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "device_name",
        "chip",
        "unified_memory_bytes",
        "os_version",
        "ax_engine_version",
        "mlx_version",
        "mlx_lm_version",
        "power_mode",
        "kernel_fallbacks"
      ],
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "ParetoPoint": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "candidate_model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "dominated_by": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frontier": {
          "type": "boolean"
        },
        "hardware": {
          "$ref": "#/$defs/CompleteCandidateHardware"
        },
        "measured_bpw": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "measurement_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "mtp_acceptance_retention": {
          "minimum": 0.0,
          "type": "number"
        },
        "mtp_speedup": {
          "minimum": 0.0,
          "type": "number"
        },
        "peak_memory_ratio": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "plan_sha256": {
          "type": "string"
        },
        "quality_retention": {
          "minimum": 0.0,
          "type": "number"
        },
        "validation_passed": {
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "candidate_model",
        "plan_sha256",
        "measured_bpw",
        "quality_retention",
        "mtp_acceptance_retention",
        "mtp_speedup",
        "peak_memory_ratio",
        "hardware",
        "validation_passed",
        "frontier"
      ],
      "type": "object"
    },
    "ProfileName": {
      "enum": [
        "general",
        "agent-coding",
        "agent",
        "coding",
        "translation",
        "reasoning",
        "long-context",
        "cjk",
        "rag",
        "ocr",
        "vlm"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "frontier_candidate_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "measurement_set_sha256": {
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/ParetoPoint"
      },
      "minItems": 1,
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/ProfileName"
    },
    "schema_version": {
      "const": "axquant.pareto.v3",
      "default": "axquant.pareto.v3",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "measurement_set_sha256",
    "points",
    "frontier_candidate_ids"
  ],
  "type": "object"
}
