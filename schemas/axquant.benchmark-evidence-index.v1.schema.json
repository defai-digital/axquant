{
  "$defs": {
    "BenchmarkEvidenceEntry": {
      "additionalProperties": false,
      "properties": {
        "evaluation_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evaluation_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/BenchmarkEvidenceKind"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "status"
      ],
      "type": "object"
    },
    "BenchmarkEvidenceKind": {
      "enum": [
        "bf16",
        "uniform-4bit",
        "uniform-6bit",
        "mixed-precision",
        "awq",
        "dwq",
        "gptq",
        "axquant-mtp-off",
        "axquant-mtp-on"
      ],
      "type": "string"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "ProfileName": {
      "enum": [
        "general",
        "agent-coding",
        "agent",
        "coding",
        "translation",
        "reasoning",
        "long-context",
        "cjk",
        "rag",
        "ocr",
        "vlm"
      ],
      "type": "string"
    },
    "RuntimeName": {
      "enum": [
        "ax-engine",
        "mlx-lm",
        "mlx-audio",
        "mlx-vlm"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dataset_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/BenchmarkEvidenceEntry"
      },
      "minItems": 1,
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/ProfileName"
    },
    "random_seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "release_ready": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "axquant.benchmark-evidence-index.v1",
      "default": "axquant.benchmark-evidence-index.v1",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "entries",
    "release_ready"
  ],
  "type": "object"
}
