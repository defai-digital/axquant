{
  "$defs": {
    "BenchmarkConfig": {
      "additionalProperties": false,
      "properties": {
        "baseline_kind": {
          "enum": [
            "bf16",
            "uniform-4bit",
            "uniform-6bit",
            "mixed-precision",
            "awq",
            "dwq",
            "gptq",
            "axquant-mtp-off",
            "axquant-mtp-on",
            "candidate"
          ],
          "type": "string"
        },
        "dataset_sha256": {
          "type": "string"
        },
        "draft_depth": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ignore_eos": {
          "default": false,
          "type": "boolean"
        },
        "max_tokens": {
          "default": 512,
          "minimum": 1,
          "type": "integer"
        },
        "measured_trials": {
          "default": 5,
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "mtp_enabled": {
          "default": false,
          "type": "boolean"
        },
        "power_mode": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_count": {
          "minimum": 1,
          "type": "integer"
        },
        "quantizer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantizer_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "random_seed": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeName",
          "default": "ax-engine"
        },
        "runtime_env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "schema_version": {
          "const": "axquant.benchmark-config.v1",
          "default": "axquant.benchmark-config.v1",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "type": "number"
        },
        "timeout_seconds": {
          "default": 300.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "top_k": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "top_p": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "warmup_trials": {
          "default": 2,
          "minimum": 0,
          "type": "integer"
        },
        "workload": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "baseline_kind",
        "workload",
        "dataset_sha256",
        "prompt_count"
      ],
      "type": "object"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "RuntimeName": {
      "enum": [
        "ax-engine",
        "mlx-lm",
        "mlx-audio",
        "mlx-vlm"
      ],
      "type": "string"
    },
    "SoftwareVersions": {
      "additionalProperties": false,
      "properties": {
        "ax_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "axquant": {
          "type": "string"
        },
        "mlx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mlx_lm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pydantic": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "safetensors": {
          "type": "string"
        }
      },
      "required": [
        "axquant",
        "python",
        "safetensors",
        "pydantic"
      ],
      "type": "object"
    },
    "TrialResult": {
      "additionalProperties": false,
      "properties": {
        "backend_report": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "backend_stderr": {
          "default": "",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decode_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_warmup": {
          "default": false,
          "type": "boolean"
        },
        "kernel_fallbacks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latency_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "type": "number"
        },
        "mtp_accepted_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_decode_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_proposed_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_rejected_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "os_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_token_ids": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prefill_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "runtime_chip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime_device_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "success": {
          "default": true,
          "type": "boolean"
        },
        "terminal_stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_to_first_token_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tokens_generated": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "tokens_per_second": {
          "default": 0.0,
          "minimum": 0.0,
          "type": "number"
        },
        "trial_index": {
          "minimum": 0,
          "type": "integer"
        },
        "unified_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_overhead_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "trial_index"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ax_engine_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config": {
      "$ref": "#/$defs/BenchmarkConfig"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "failed_count": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "latency_p50": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latency_p90": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latency_p99": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "measured_count": {
      "minimum": 0,
      "type": "integer"
    },
    "os_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_chip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_device_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "axquant.benchmark-result.v1",
      "default": "axquant.benchmark-result.v1",
      "type": "string"
    },
    "software_versions": {
      "anyOf": [
        {
          "$ref": "#/$defs/SoftwareVersions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timed_out_count": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "tokens_per_second_p50": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tokens_per_second_p90": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tokens_per_second_p99": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/TrialResult"
      },
      "type": "array"
    },
    "unified_memory_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "config",
    "trials",
    "measured_count"
  ],
  "type": "object"
}
