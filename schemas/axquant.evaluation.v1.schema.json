      },
      "type": "object"
    },
    "IntegrityMetrics": {
      "additionalProperties": false,
      "properties": {
        "config_valid": {
          "type": "boolean"
        },
        "index_complete": {
          "type": "boolean"
        },
        "mtp_layout_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "safetensors_valid": {
          "type": "boolean"
        },
        "source_revision_pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "safetensors_valid",
        "index_complete",
        "config_valid",
        "source_revision_pinned"
      ],
      "type": "object"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "MtpMetrics": {
      "additionalProperties": false,
      "properties": {
        "acceptance_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "average_accepted_tokens": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "divergence_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effective_tokens_per_forward": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rejection_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repetition_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "token_accuracy": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "QualityMetrics": {
      "additionalProperties": false,
      "properties": {
        "json_valid_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "perplexity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "syntax_valid_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "RuntimeName": {
      "enum": [
        "ax-engine",
        "mlx-lm",
        "mlx-audio",
        "mlx-vlm"
      ],
      "type": "string"
    },
    "SoftwareVersions": {
      "additionalProperties": false,
      "properties": {
        "ax_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "axquant": {
          "type": "string"
        },
        "mlx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mlx_lm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pydantic": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "safetensors": {
          "type": "string"
        }
      },
      "required": [
        "axquant",
        "python",
        "safetensors",
        "pydantic"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_kind": {
      "enum": [
        "bf16",
        "uniform-4bit",
        "uniform-6bit",
        "mixed-precision",
        "awq",
        "dwq",
        "gptq",
        "axquant-mtp-off",
        "axquant-mtp-on",
        "candidate"
      ],
      "type": "string"
    },
    "benchmark_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dataset_sha256": {
      "type": "string"
    },
    "hardware": {
      "$ref": "#/$defs/HardwareMetrics"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityMetrics"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "mtp": {
      "anyOf": [
        {
          "$ref": "#/$defs/MtpMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mtp_enabled": {
      "default": false,
      "type": "boolean"
    },
    "quality": {
      "$ref": "#/$defs/QualityMetrics"
    },
    "random_seed": {
      "minimum": 0,
      "type": "integer"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeName",
      "default": "ax-engine"
    },
    "schema_version": {
      "const": "axquant.evaluation.v1",
      "default": "axquant.evaluation.v1",
      "type": "string"
    },
    "software_versions": {
      "$ref": "#/$defs/SoftwareVersions"
    },
    "workload": {
      "type": "string"
    }
  },
  "required": [
    "model",
    "baseline_kind",
    "integrity",
    "workload",
    "dataset_sha256",
    "software_versions",
    "random_seed"
  ],
  "type": "object"
}
