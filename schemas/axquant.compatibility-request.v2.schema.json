{
  "$defs": {
    "CompatibilityCandidateInput": {
      "additionalProperties": false,
      "properties": {
        "artifact_directory": {
          "minLength": 1,
          "type": "string"
        },
        "ax_engine_check": {
          "minLength": 1,
          "type": "string"
        },
        "mlx_lm_check": {
          "minLength": 1,
          "type": "string"
        },
        "validation_report": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "artifact_directory",
        "ax_engine_check",
        "mlx_lm_check",
        "validation_report"
      ],
      "type": "object"
    },
    "OfficialDenseCheckpointRequirement": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "pattern": "^Qwen/Qwen3\\.6-[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "parameter_size": {
          "pattern": "^[1-9][0-9]*(?:\\.[0-9]+)?[BMT]$",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "parameter_size"
      ],
      "type": "object"
    },
    "ProfileName": {
      "enum": [
        "general",
        "agent-coding",
        "agent",
        "coding",
        "translation",
        "reasoning",
        "long-context",
        "cjk",
        "rag",
        "ocr",
        "vlm"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/CompatibilityCandidateInput"
      },
      "minItems": 1,
      "type": "array"
    },
    "catalog_verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "family": {
      "const": "Qwen 3.6",
      "default": "Qwen 3.6",
      "type": "string"
    },
    "official_catalog_url": {
      "const": "https://huggingface.co/collections/Qwen/qwen36",
      "default": "https://huggingface.co/collections/Qwen/qwen36",
      "type": "string"
    },
    "required_dense_models": {
      "items": {
        "$ref": "#/$defs/OfficialDenseCheckpointRequirement"
      },
      "minItems": 1,
      "type": "array"
    },
    "required_profiles": {
      "items": {
        "$ref": "#/$defs/ProfileName"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "schema_version": {
      "const": "axquant.compatibility-request.v2",
      "default": "axquant.compatibility-request.v2",
      "type": "string"
    },
    "scope_policy": {
      "const": "all-official-dense-sizes-at-release",
      "default": "all-official-dense-sizes-at-release",
      "type": "string"
    }
  },
  "required": [
    "catalog_verified_at",
    "required_dense_models",
    "candidates"
  ],
  "type": "object"
}
