{
  "$defs": {
    "PublicCertArtifact": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact_edition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hub_commit": {
          "minLength": 8,
          "type": "string"
        },
        "hub_repo_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "hub_tag": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "marketing_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product_class": {
          "minLength": 1,
          "type": "string"
        },
        "source_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upstream_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "hub_repo_id",
        "hub_commit",
        "product_class"
      ],
      "type": "object"
    },
    "PublicIndexMeta": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "minLength": 1,
          "type": "string"
        },
        "edition_label": {
          "minLength": 1,
          "type": "string"
        },
        "listed": {
          "default": true,
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer"
        }
      },
      "required": [
        "display_name",
        "sort_order",
        "edition_label"
      ],
      "type": "object"
    },
    "PublicMtpAccelerationBlock": {
      "additionalProperties": false,
      "properties": {
        "ax_engine_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "engine_binary_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exactness_required": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_median_speedup_required": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "not-certified",
            "not-applicable",
            "certified",
            "certified-scoped",
            "certified-see-tier2-record"
          ],
          "type": "string"
        },
        "tier2_certificate": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "token_weighted_decode_speedup_required": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/PublicCertArtifact"
    },
    "certification_tier": {
      "const": "checkpoint",
      "default": "checkpoint",
      "type": "string"
    },
    "certified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "datasets": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_hashes": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_scope": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "host_id": {
      "minLength": 1,
      "type": "string"
    },
    "mtp_acceleration": {
      "$ref": "#/$defs/PublicMtpAccelerationBlock"
    },
    "notes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan": {
      "additionalProperties": true,
      "type": "object"
    },
    "public_index": {
      "$ref": "#/$defs/PublicIndexMeta"
    },
    "quality": {
      "additionalProperties": true,
      "type": "object"
    },
    "quality_bound_pre_fuse_revision": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_default": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "axquant.public-checkpoint-certification.v1",
      "default": "axquant.public-checkpoint-certification.v1",
      "type": "string"
    },
    "size": {
      "additionalProperties": true,
      "type": "object"
    },
    "status": {
      "enum": [
        "certified",
        "not_certified"
      ],
      "type": "string"
    },
    "thresholds": {
      "additionalProperties": true,
      "type": "object"
    },
    "toolchain": {
      "additionalProperties": true,
      "type": "object"
    },
    "weight_files": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status",
    "host_id",
    "artifact",
    "plan",
    "size",
    "quality",
    "thresholds",
    "mtp_acceleration",
    "toolchain",
    "public_index"
  ],
  "type": "object"
}
