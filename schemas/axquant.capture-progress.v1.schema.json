    "cache_key_sha256": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "max_rows": {
      "minimum": 1,
      "type": "integer"
    },
    "model": {
      "type": "string"
    },
    "model_fingerprint_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
