{
  "$defs": {
    "BoundFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "$ref": "#/$defs/BoundFile"
    },
    "campaign_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checks_reviewed": {
      "items": {
        "enum": [
          "freeze",
          "candidate-selection",
          "raw-to-summary",
          "hardware-pareto",
          "reproduction",
          "public-claims"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "legacy_audit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "axquant.flagship-review.v1",
      "default": "axquant.flagship-review.v1",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "type": "string"
    }
  },
  "required": [
    "campaign_sha256",
    "candidate_sha256",
    "legacy_audit_sha256",
    "reviewer",
    "checks_reviewed",
    "verdict",
    "issues",
    "attestation"
  ],
  "type": "object"
}
