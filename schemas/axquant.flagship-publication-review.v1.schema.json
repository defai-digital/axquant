{
  "$defs": {
    "BoundFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "$ref": "#/$defs/BoundFile"
    },
    "authorization_audit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "campaign_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "model_card_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "public_claim_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "axquant.flagship-publication-review.v1",
      "default": "axquant.flagship-publication-review.v1",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "type": "string"
    }
  },
  "required": [
    "campaign_sha256",
    "candidate_sha256",
    "authorization_audit_sha256",
    "public_claim_sha256",
    "model_card_sha256",
    "reviewer",
    "verdict",
    "issues",
    "attestation"
  ],
  "type": "object"
}
