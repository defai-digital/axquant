        "runtime_env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "schema_version": {
          "const": "axquant.mtp-ab-comparison.v1",
          "default": "axquant.mtp-ab-comparison.v1",
          "type": "string"
        },
        "software_versions": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoftwareVersions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speedup": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speedup_metric": {
          "default": "prompt-median-tps",
          "enum": [
            "prompt-median-tps",
            "token-weighted-decode-tps"
          ],
          "type": "string"
        },
        "speedup_pass": {
          "default": false,
          "type": "boolean"
        },
        "token_weighted_decode_speedup": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
