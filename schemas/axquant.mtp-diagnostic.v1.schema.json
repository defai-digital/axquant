{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "measured",
        "measured_development",
        "imported",
        "architecture_prior"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "MtpAbComparison": {
      "additionalProperties": false,
      "properties": {
        "ax_engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "dataset_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direct_token_weighted_decode_tps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direct_tokens_per_second_p50": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "divergent_trial_count": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "draft_depth": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exactness_pass": {
          "type": "boolean"
        },
        "failed_trial_count": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "generation_controls": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "measured_trial_count": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "minimum_prompt_median_speedup": {
          "default": 1.1,
          "minimum": 0.0,
          "type": "number"
        },
        "minimum_speedup": {
          "default": 1.2,
          "minimum": 0.0,
          "type": "number"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_token_weighted_decode_tps": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_tokens_per_second_p50": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phase_timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/MtpPhaseTimingSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_name": {
          "type": "string"
        },
        "prompt_median_speedup": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_median_speedup_pass": {
          "default": false,
          "type": "boolean"
        },
        "random_seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
