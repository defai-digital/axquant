{
  "$defs": {
    "ArchitectureFingerprint": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "Qwen3NextForCausalLM",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "expert_count": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "expert_intermediate_size": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "experts_per_token": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "full_attention_interval": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "hidden_size": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "model_type": {
          "const": "qwen3_next",
          "type": "string"
        },
        "mtp_declared": {
          "const": false,
          "type": "boolean"
        },
        "text_layer_count": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "vision_present": {
          "type": "boolean"
        }
      },
      "required": [
        "model_type",
        "architecture",
        "text_layer_count",
        "hidden_size",
        "full_attention_interval",
        "expert_count",
        "experts_per_token",
        "expert_intermediate_size",
        "mtp_declared",
        "vision_present",
        "config_sha256",
        "tokenizer_sha256"
      ],
      "type": "object"
    },
    "CertifiedCheckpointEntry": {
      "additionalProperties": false,
      "properties": {
        "allowed_claims": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "artifact_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "candidate_model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "certification_scope": {
          "$ref": "#/$defs/ExactCertificationScope"
        },
        "certified_at": {
          "format": "date-time",
          "type": "string"
        },
        "entry_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "hardware_scope_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "measured_bpw": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "release_audit_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "supersedes_entry_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "entry_id",
        "certification_scope",
        "candidate_model",
        "candidate_id",
        "policy_sha256",
        "artifact_manifest_sha256",
        "release_audit_sha256",
        "measured_bpw",
        "allowed_claims",
        "hardware_scope_ids",
        "certified_at"
      ],
      "type": "object"
    },
    "ExactCertificationScope": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/ArchitectureFingerprint"
        },
        "artifact_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "hardware_scope_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "policy_id": {
          "const": "axquant.qwen3-next-direct-policy.v1",
          "default": "axquant.qwen3-next-direct-policy.v1",
          "type": "string"
        },
        "source_model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "target_class": {
          "$ref": "#/$defs/Qwen3NextTargetClass"
        },
        "track": {
          "const": "qwen3-next-direct-v1",
          "default": "qwen3-next-direct-v1",
          "type": "string"
        }
      },
      "required": [
        "source_model",
        "architecture",
        "target_class",
        "artifact_manifest_sha256",
        "hardware_scope_ids"
      ],
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "Qwen3NextTargetClass": {
      "enum": [
        "4bit",
        "6bit"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CertifiedCheckpointEntry"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "axquant.certified-checkpoint-registry.v1",
      "default": "axquant.certified-checkpoint-registry.v1",
      "type": "string"
    }
  },
  "type": "object"
}
