{
  "$defs": {
    "AxEngineOptimizationMetadata": {
      "additionalProperties": false,
      "properties": {
        "decode_kernel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fused_mtp": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kernel_evidence": {
          "default": "unmeasured",
          "enum": [
            "unmeasured",
            "measured"
          ],
          "type": "string"
        },
        "model_manifest": {
          "default": "model-manifest.json",
          "type": "string"
        },
        "preferred_group_size": {
          "default": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "KvCacheRuntimeMetadata": {
      "additionalProperties": false,
      "properties": {
        "advisory": {
          "const": true,
          "default": true,
          "type": "boolean"
        },
        "advisory_mlx_lm_kv_bits": {
          "maximum": 16,
          "minimum": 2,
          "type": "integer"
        },
        "advisory_mlx_lm_kv_group_size": {
          "minimum": 1,
          "type": "integer"
        },
        "allocation_basis": {
          "enum": [
            "architecture-prior",
            "measured"
          ],
          "type": "string"
        },
        "layer_bits": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "layer_group_sizes": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "allocation_basis",
        "layer_bits",
        "layer_group_sizes",
        "advisory_mlx_lm_kv_bits",
        "advisory_mlx_lm_kv_group_size"
      ],
      "type": "object"
    },
    "MtpRuntimeMetadata": {
      "additionalProperties": false,
      "properties": {
        "acceptance_retention": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detected": {
          "type": "boolean"
        },
        "draft_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled_by_default": {
          "default": false,
          "type": "boolean"
        },
        "head_precision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "measured_speedup": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "optimized": {
          "default": false,
          "type": "boolean"
        },
        "recommended_temperature_max": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sidecar_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "detected"
      ],
      "type": "object"
    },
    "OptimizationScope": {
      "enum": [
        "text-path",
        "full-model",
        "inventory-only"
      ],
      "type": "string"
    },
    "RuntimeName": {
      "enum": [
        "ax-engine",
        "mlx-lm",
        "mlx-audio",
        "mlx-vlm"
      ],
      "type": "string"
    },
    "RuntimeProfile": {
      "additionalProperties": false,
      "properties": {
        "compatibility_level": {
          "enum": [
            "A",
            "B"
          ],
          "type": "string"
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mtp_support": {
          "enum": [
            "native",
            "runtime-dependent",
            "none"
          ],
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/RuntimeName"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "standard_inference": {
          "type": "boolean"
        },
        "standard_mlx_weights": {
          "default": true,
          "type": "boolean"
        },
        "support_level": {
          "$ref": "#/$defs/RuntimeSupportLevel"
        }
      },
      "required": [
        "name",
        "compatibility_level",
        "support_level",
        "standard_inference",
        "mtp_support"
      ],
      "type": "object"
    },
    "RuntimeSupportLevel": {
      "enum": [
        "optimized",
        "standard-inference"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ax_engine": {
      "$ref": "#/$defs/AxEngineOptimizationMetadata"
    },
    "compatible_runtimes": {
      "items": {
        "$ref": "#/$defs/RuntimeProfile"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "kv_cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/KvCacheRuntimeMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "memory_policy": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": "object"
    },
    "mtp": {
      "$ref": "#/$defs/MtpRuntimeMetadata"
    },
    "optimization_scope": {
      "$ref": "#/$defs/OptimizationScope"
    },
    "primary_runtime": {
      "$ref": "#/$defs/RuntimeProfile"
    },
    "schema_version": {
      "const": "axquant.runtime.v1",
      "default": "axquant.runtime.v1",
      "type": "string"
    }
  },
  "required": [
    "primary_runtime",
    "compatible_runtimes",
    "optimization_scope",
    "mtp",
    "ax_engine"
  ],
  "type": "object"
}
