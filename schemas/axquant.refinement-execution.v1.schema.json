{
  "$defs": {
    "ProfileName": {
      "enum": [
        "general",
        "agent-coding",
        "agent",
        "coding",
        "translation",
        "reasoning",
        "long-context",
        "cjk",
        "rag",
        "ocr",
        "vlm"
      ],
      "type": "string"
    },
    "RefinementExecutionStep": {
      "additionalProperties": false,
      "properties": {
        "acceptable_exit_codes": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gate_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "state": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "type": "string"
        },
        "stderr": {
          "default": "",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "command"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "complete": {
      "default": false,
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "failed_candidate_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "input_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "measured_candidate_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pareto_report": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile": {
      "$ref": "#/$defs/ProfileName"
    },
    "refinement_sha256": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string"
    },
    "schema_version": {
      "const": "axquant.refinement-execution.v1",
      "default": "axquant.refinement-execution.v1",
      "type": "string"
    },
    "selected_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RefinementExecutionStep"
      },
      "minItems": 1,
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "request_sha256",
    "refinement_sha256",
    "profile",
    "input_sha256",
    "steps"
  ],
  "type": "object"
}
