{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "measured",
        "measured_development",
        "imported",
        "architecture_prior"
      ],
      "type": "string"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    },
    "ProfileName": {
      "enum": [
        "general",
        "agent-coding",
        "agent",
        "coding",
        "translation",
        "reasoning",
        "long-context",
        "cjk",
        "rag",
        "ocr",
        "vlm"
      ],
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "inventory_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kv_allocation_basis": {
      "default": "off",
      "enum": [
        "architecture-prior",
        "measured",
        "off"
      ],
      "type": "string"
    },
    "kv_sensitivity_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/ProfileName"
    },
    "schema_version": {
      "const": "axquant.unified-sensitivity.v1",
      "default": "axquant.unified-sensitivity.v1",
      "type": "string"
    },
    "source_model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "weight_evidence_kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "weight_sensitivity_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    }
  },
  "required": [
    "source_model",
    "profile",
    "weight_sensitivity_sha256",
    "weight_evidence_kind"
  ],
  "type": "object"
}
