{
  "$defs": {
    "CheckpointKey": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_members_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "schema_version": {
          "const": "axquant.checkpoint-key.v1",
          "default": "axquant.checkpoint-key.v1",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "weight_index_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "model",
        "config_sha256",
        "tokenizer_sha256",
        "weight_index_sha256",
        "checkpoint_members_sha256"
      ],
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format": {
          "const": "mlx",
          "default": "mlx",
          "type": "string"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_id": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model_id"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation_capture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "artifact_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "certification_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_members_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "axquant.candidate-key.v1",
      "default": "axquant.candidate-key.v1",
      "type": "string"
    },
    "sensitivity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CheckpointKey"
    }
  },
  "required": [
    "source",
    "certification_policy_sha256",
    "calibration_sha256",
    "activation_capture_sha256",
    "sensitivity_sha256",
    "plan_sha256",
    "artifact_manifest_sha256",
    "checkpoint_members_sha256"
  ],
  "type": "object"
}
